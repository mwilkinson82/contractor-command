            },
            "next_action": {
              "description": "open_item",
              "type": "string",
              "maxLength": 2000
            },
            "next_action_approved_by": {
              "description": "open_item",
              "type": "string",
              "maxLength": 2000
            },
            "internal_only": {
              "type": "boolean"
            },
            "start_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "schedule_export": {
              "description": "lookahead: schedule export, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "crews": {
              "description": "lookahead: crews/subs by day, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "submittal_log": {
              "description": "lookahead: submittal log, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "rfi_log": {
              "description": "lookahead: RFI log, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "inspection_list": {
              "description": "lookahead: inspection list, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "deliveries": {
              "description": "lookahead: deliveries list, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "section",
            "job_number"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
