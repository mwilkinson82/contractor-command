      {
        "name": "answer",
        "title": "Answer or mark N/A",
        "description": "Answer the current question (yes / no / na / unknown), mark an item or section N/A, re-enable it, or decline a re-enable suggestion. N/A only stops future questions; it never closes open items. Unknown opens a confirm item.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Job number, exact match (e.g. 2417)."
            },
            "company_id": {
              "description": "Only needed if you belong to more than one company.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "action": {
              "description": "Default answer.",
              "type": "string",
              "enum": [
                "answer",
                "mark_na",
                "reenable",
                "decline_reenable"
              ]
            },
            "check_key": {
              "description": "answer: check_key from next_question. mark_na/reenable with scope item: the check_key.",
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "response": {
              "description": "answer: yes / no / na / unknown.",
              "type": "string",
              "enum": [
                "yes",
                "no",
                "na",
                "unknown"
              ]
            },
            "detail": {
              "description": "Details, or the N/A reason (max 10,000 characters).",
              "type": "string",
              "maxLength": 10000
            },
            "owner": {
              "description": "Accountable person for a follow-up. Leave out if unknown.",
              "type": "string",
              "maxLength": 200
            },
            "due_date": {
              "description": "Needed-by date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "scope": {
              "description": "mark_na / reenable: item or section.",
              "type": "string",
              "enum": [
                "item",
                "section"
              ]
            },
            "section": {
              "description": "mark_na / reenable with scope section: section name, e.g. bid_documents, insurance_bonding, contract_time, self_perform_premob.",
              "type": "string",
              "maxLength": 60
            },
            "na_id": {
              "description": "decline_reenable: na_id from the suggestion.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "lookahead_id": {
              "description": "Only for a two-week lookahead question.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "required": [
            "job_number"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "report",
        "title": "Job report",
        "description": "Render the fixed job setup report (internal or client-facing), or the two-week lookahead report when lookahead_id is given. Client-facing reports leave out internal cost and strategy detail.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
