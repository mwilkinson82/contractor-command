            "owner": {
              "description": "open_item: accountable named person",
              "type": "string",
              "maxLength": 2000
            },
            "needed_by": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "cost_effect": {
              "description": "open_item",
              "type": "string",
              "maxLength": 2000
            },
            "time_effect": {
              "description": "open_item",
              "type": "string",
              "maxLength": 2000
            },
            "cash_effect": {
              "description": "open_item",
              "type": "string",
              "maxLength": 2000
            },
            "effect_is_estimate": {
