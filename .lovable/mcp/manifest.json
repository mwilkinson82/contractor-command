    "tools": [
      {
        "name": "onboarding",
        "title": "Company profile and members",
        "description": "Read or save the company profile the PM agent works for (role, work types, trades, tool stack, decision rights, default applicability), and add members as Owner, PM or All-access.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "read",
                "save_company",
                "add_member"
              ],
              "description": "read, save_company (create or update), or add_member."
            },
            "company_id": {
              "description": "Only needed if you belong to more than one company.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "name": {
              "description": "Company name (required to create).",
              "type": "string",
              "maxLength": 200
            },
            "your_name": {
              "description": "Your display name on the company (when creating).",
              "type": "string",
              "maxLength": 120
            },
            "agent_name": {
              "description": "What to call the agent. Default 'PM agent'.",
              "type": "string",
              "maxLength": 60
            },
            "company_role": {
              "description": "Company role, e.g. mechanical prime / specialty sub.",
              "type": "string",
              "maxLength": 2000
            },
            "work_types": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "commercial",
                  "public",
                  "residential"
                ]
              }
            },
            "trades": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "tool_stack": {
              "description": "Tools by function, e.g. {schedule: 'P6', accounting: '...'}.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 60
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              }
            },
            "decision_rights": {
              "description": "Who may approve each: roles (owner, pm, all_access) or member names.",
              "type": "object",
              "properties": {
                "buyout": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "change_orders": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "claims": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "write_offs": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                },
                "waive_items": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  }
                }
              }
            },
            "default_flags": {
              "description": "Company default applicability flags, e.g. {residential: 'no'}.",
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z_]{1,40}$"
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "yes",
                  "no",
                  "na",
                  "unknown"
                ]
              }
            },
            "member_email": {
              "description": "add_member: the person's sign-in email.",
              "type": "string",
              "format": "email",
              "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
            },
            "member_name": {
              "description": "add_member: display name.",
              "type": "string",
              "maxLength": 120
            },
            "member_role": {
              "description": "add_member: launch role.",
              "type": "string",
              "enum": [
                "owner",
                "pm",
                "all_access"
              ]
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "intake",
        "title": "Job setup intake",
        "description": "Create a job (keyed by job number) and record its setup: step 0 scoping, contract terms, estimate handoff, budget and SOV, open items, or a two-week lookahead. Missing data is recorded as unknown, never guessed.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "section": {
              "type": "string",
              "enum": [
                "create_job",
                "scope",
                "contract",
                "handoff",
                "budget",
                "open_item",
                "lookahead"
              ],
              "description": "Which part of setup to record."
            },
            "job_number": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "description": "Job number, exact match (e.g. 2417)."
            },
            "company_id": {
              "description": "Only needed if you belong to more than one company.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "job_name": {
              "description": "create_job: job name.",
              "type": "string",
              "maxLength": 200
            },
            "restrict_to": {
              "description": "create_job: member names who may see this job (leave out for all members).",
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "job_type": {
              "description": "scope: job type / trade.",
              "type": "string",
              "maxLength": 2000
            },
            "scope_summary": {
              "description": "scope: short scope summary.",
              "type": "string",
              "maxLength": 2000
            },
            "size_band": {
              "type": "string",
              "enum": [
                "<$250k",
                "$250k–$2M",
                "$2M–$10M",
                "$10M+"
              ]
            },
            "sector": {
              "type": "string",
              "enum": [
                "public",
                "private_commercial",
                "residential"
              ]
            },
            "client_type": {
              "description": "scope: client type.",
              "type": "string",
              "maxLength": 2000
            },
            "pricing_model": {
              "type": "string",
              "enum": [
                "lump_sum",
                "unit_price",
                "cost_plus",
                "gmp"
              ]
            },
            "position": {
              "type": "string",
              "enum": [
                "prime",
                "sub",
                "sub_sub"
              ]
            },
            "work_packages": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "mode": {
                    "type": "string",
                    "enum": [
                      "self_perform",
                      "subcontract"
                    ]
                  }
                },
                "required": [
                  "name",
                  "mode"
                ]
              }
            },
            "major_equipment": {
              "description": "scope: major equipment; [] means none.",
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "key_clauses": {
              "description": "scope: which key clauses the job has.",
              "type": "object",
              "properties": {
                "retainage": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "na",
                    "unknown"
                  ]
                },
                "beneficial_use": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "na",
                    "unknown"
                  ]
                },
                "liquidated_damages": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "na",
                    "unknown"
                  ]
                },
                "notice": {
                  "type": "string",
                  "enum": [
                    "yes",
                    "no",
                    "na",
                    "unknown"
                  ]
                }
              }
            },
            "job_tool_stack": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "maxLength": 60
              },
              "additionalProperties": {
                "type": "string",
                "maxLength": 200
              }
            },
            "contract_document_provided": {
              "description": "contract: true only if these terms were read from the contract. Without it every clause stays unknown.",
              "type": "boolean"
            },
            "pay_terms": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "notice_timing": {
              "description": "contract: notice deadline and clause, as written",
              "type": "string",
              "maxLength": 2000
            },
            "tia_timing": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "change_process": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "claim_process": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "retainage": {
              "description": "contract: % and clause",
              "type": "string",
              "maxLength": 2000
            },
            "retainage_reduction": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "beneficial_use_clause": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "liquidated_damages": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "savings_split": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "closeout": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "warranty_clauses": {
              "description": "contract",
              "type": "string",
              "maxLength": 2000
            },
            "sold_scope": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "carried_scope": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "exclusions": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "allowances": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "addenda": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "concessions": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "quantities": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "production_rates": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "crew_assumptions": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "sub_qualifications": {
              "description": "handoff",
              "type": "string",
              "maxLength": 2000
            },
            "gaps": {
              "description": "handoff: each gap becomes an open item with its named owner.",
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "gap": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "needed_by": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  }
                },
                "required": [
                  "gap",
                  "owner"
                ]
              }
            },
            "budget_lines": {
              "description": "budget: internal cost budget by cost code (internal only).",
              "maxItems": 300,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "cost_code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": [
                  "cost_code"
                ]
              }
            },
            "sov_lines": {
              "description": "budget: owner SOV lines at billable value, with the cost codes each maps to.",
              "maxItems": 300,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "line": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "billable_value": {
                    "type": "number"
