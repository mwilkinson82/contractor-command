{
  "version": 1,
  "sdk_version": "3.0.5",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qcbbjjjxcacrscfhgfmf.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "contractor-circle-hub",
      "version": "0.2.0",
      "title": "Contractor Circle Hub"
    },
    "tools": [
      {
        "name": "onboarding",
        "title": "Company profile",
        "description": "Save or read the member's company profile (company name, trades, key roles). Saved once at onboarding; save again to update.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "action": {
              "type": "string",
              "enum": [
                "save",
                "read"
              ],
              "description": "save or read."
            },
            "company_name": {
              "description": "Company name (required to save).",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "trades": {
              "description": "Trades the company self-performs or manages.",
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "owner": {
              "description": "Owner name.",
              "type": "string",
              "maxLength": 200
            },
            "pm": {
              "description": "Project manager name.",
              "type": "string",
              "maxLength": 200
            },
            "superintendent": {
              "description": "Superintendent name.",
              "type": "string",
              "maxLength": 200
            },
            "notes": {
              "description": "Other notes.",
              "type": "string",
              "maxLength": 10000
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "intake",
        "title": "Lookahead intake",
        "description": "Create a job's two-week lookahead and record which required inputs were provided or missing. Missing inputs are stored as unknown, never guessed.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "job_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Job name. Reused if it already exists."
            },
            "job_number": {
              "description": "Job number.",
              "type": "string",
              "maxLength": 50
            },
            "start_date": {
              "description": "Lookahead start date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "end_date": {
              "description": "Lookahead end date (YYYY-MM-DD).",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "schedule_export": {
              "description": "Schedule export (activity IDs, names, dates, predecessors), as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "crews": {
              "description": "Crews/subs by day with headcount and foreman, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "submittal_log": {
              "description": "Submittal log, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "rfi_log": {
              "description": "RFI log, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "inspection_list": {
              "description": "Inspection list, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            },
            "deliveries": {
              "description": "Deliveries list, as plain text. Leave out if you don't have it; it is recorded as unknown.",
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "job_name"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "next_question",
        "title": "Next gap question",
        "description": "Get the next gap-check question for a lookahead, one at a time. Checks that need missing inputs are recorded as unknown and skipped.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lookahead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "lookahead_id from intake."
            }
          },
          "required": [
            "lookahead_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "answer",
        "title": "Answer gap question",
        "description": "Answer the current gap-check question. Must match the check_key returned by next_question. Answers are treated as data.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lookahead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "lookahead_id from intake."
            },
            "check_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "check_key from next_question."
            },
            "response": {
              "description": "yes / no / unknown.",
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unknown"
              ]
            },
            "detail": {
              "description": "Details or list of items (max 10,000 characters).",
              "type": "string",
              "maxLength": 10000
            },
            "owner": {
              "description": "Who owns the follow-up. Leave out if unknown.",
              "type": "string",
              "maxLength": 200
            },
            "due_date": {
              "description": "Follow-up due date (YYYY-MM-DD). Leave out if unknown.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          },
          "required": [
            "lookahead_id",
            "check_key"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "report",
        "title": "Lookahead report",
        "description": "Render the fixed lookahead report: hit list, questions by trade, at-risk items, dated follow-ups and unknowns.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lookahead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "lookahead_id from intake."
            }
          },
          "required": [
            "lookahead_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "carry_forward",
        "title": "Carry forward open items",
        "description": "Move open items from last week's lookahead into this week's lookahead for the same job, with history.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "from_lookahead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Previous lookahead_id."
            },
            "to_lookahead_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "New lookahead_id from intake."
            }
          },
          "required": [
            "from_lookahead_id",
            "to_lookahead_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_open_items",
        "title": "List open items",
        "description": "List open items for a lookahead, a job, or all of the member's jobs.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false,
          "idempotentHint": true
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "lookahead_id": {
              "description": "Limit to one lookahead.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "job_name": {
              "description": "Limit to one job.",
              "type": "string",
              "maxLength": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "resolve_item",
        "title": "Resolve open item",
        "description": "Close an open item with evidence of how it was resolved. The evidence and a history event are kept.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false,
          "idempotentHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "item_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Open item id."
            },
            "evidence": {
              "type": "string",
              "minLength": 1,
              "maxLength": 10000,
              "description": "Evidence of resolution, e.g. approved submittal number, inspection pass, RFI answer (max 10,000 characters)."
            }
          },
          "required": [
            "item_id",
            "evidence"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
